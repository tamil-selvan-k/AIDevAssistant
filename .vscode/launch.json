{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/test/scenario-a.ts"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
